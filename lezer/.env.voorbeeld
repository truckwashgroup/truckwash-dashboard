# Kopieer dit bestand naar .env (in deze map) en vul LEZER_SECRET in.
# .env staat in .gitignore en komt nooit in git.

# De functie lezer op Supabase; hier haalt het programma werk, prompt en schema.
LEZER_URL=https://yxsbmhavnttswxczeovt.supabase.co/functions/v1/lezer

# Hetzelfde geheim als op de server:  supabase secrets set LEZER_SECRET=...
# Een lange willekeurige tekst; zonder dit geheim geeft de server 403.
LEZER_SECRET=

# Het Ollama-model dat leest. Moet plaatjes kunnen lezen (ollama pull gemma4:26b).
LEZER_MODEL=gemma4:26b

# Om de hoeveel seconden er om werk gevraagd wordt.
LEZER_INTERVAL=30

# Waar Ollama draait. Alleen localhost is de bedoeling.
OLLAMA_URL=http://localhost:11434
