# Kopieer dit bestand naar .env (in deze map) en vul LEZER_SECRET in.
# .env staat in .gitignore en komt nooit in git.

# De functie lezer op Supabase; hier haalt het programma werk, prompt en schema.
LEZER_URL=https://yxsbmhavnttswxczeovt.supabase.co/functions/v1/lezer

# Hetzelfde geheim als op de server:  supabase secrets set LEZER_SECRET=...
# Een lange willekeurige tekst; zonder dit geheim geeft de server 403.
LEZER_SECRET=

# Het Ollama-model dat leest. Moet plaatjes kunnen lezen (ollama pull gemma4:26b).
LEZER_MODEL=gemma4:26b

# Wil je een ander model voor PDF's met een tekstlaag dan voor scans en foto's?
# Zet ze dan hieronder; leeg laten betekent: allebei LEZER_MODEL hierboven.
#
# Gemeten op een RTX 5090, dezelfde factuur, hetzelfde schema:
#   llama3.2 (3B)       2,9s   ONBRUIKBAAR: zei "verkoop" in plaats van "inkoop"
#   qwen2.5-coder:14b   6,8s   alles goed, maar verzon een twijfel
#   gpt-oss:20b        17,4s   alles goed
#   gemma4:26b          9,9s   alles goed (warm; de eerste keer 23,7s)
#
# Op een PDF met tekstlaag scheelt het dus maar drie seconden. De winst zit
# in het geheugen: twee modellen passen naast elkaar in 32 GB, dus een foto
# en een tekstfactuur kunnen tegelijk worden gelezen.
#
# Sneller kan dus, maar hoe kleiner het model hoe eerder het de OORDELEN mist
# -- inkoop of verkoop, en of er iets te twijfelen valt. Juist die bepalen of
# een bon verdwijnt of vanzelf wordt goedgekeurd. Probeer het eerst met
# --proef op een paar echte facturen voordat je het aan laat staan.
#LEZER_MODEL_TEKST=qwen2.5-coder:14b
#LEZER_MODEL_BEELD=gemma4:26b

# Hoeveel seconden pauze als er NIETS te doen was. Is er wel werk, dan wacht
# hij niet en gaat hij meteen door tot de stapel leeg is.
LEZER_INTERVAL=10

# Hoeveel bonnen hij per ronde opeist. Hij leest ze één voor één; dit bepaalt
# alleen hoe vaak hij tussendoor de server hoeft te vragen.
LEZER_MAX=5

# Waar Ollama draait. Alleen localhost is de bedoeling.
OLLAMA_URL=http://localhost:11434
