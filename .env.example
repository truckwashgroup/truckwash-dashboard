# Kopieer dit bestand naar .env en vul je eigen waarden in.
#
# Vind je ze in Supabase onder: Project Settings -> API
#   VITE_SUPABASE_URL       = "Project URL"
#   VITE_SUPABASE_ANON_KEY  = "anon public" key
#
# De anon-key mag in de app staan: hij geeft alleen toegang tot wat de
# beveiligingsregels (RLS) in 0001_init.sql toestaan. De "service_role" key
# hoort hier NOOIT in -- die omzeilt alle beveiliging.
#
# Laat je deze regels leeg of weg, dan gebruikt de app de ingebouwde mock.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
