{
  "name": "truckwash-dashboard",
  "productName": "Truckwash1 Dashboard",
  "version": "1.27.0",
  "description": "Truckwash1 Group - offline-first dashboard voor werknemers, klanten en management",
  "author": {
    "name": "Truckwash1 Group",
    "email": "casper@truckwash1group.nl"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-env.cjs && tsc --noEmit && vite build && node scripts/uitrol-bestanden.cjs",
    "preview": "vite preview",
    "selftest": "tsx scripts/selftest.ts",
    "sqltest": "node scripts/sqltest.mjs",
    "functions": "npm run functions:open && npm run functions:dicht",
    "functions:open": "supabase functions deploy stuur-mail ontvang-mail kassa-koppelen --no-verify-jwt --project-ref yxsbmhavnttswxczeovt",
    "functions:dicht": "supabase functions deploy nodig-uit melding-gesprek postbus-actie medewerker route kassa-apparaat factuur-lezen --project-ref yxsbmhavnttswxczeovt",
    "secrets": "supabase secrets list --project-ref yxsbmhavnttswxczeovt",
    "xmltest": "python scripts/xml-nakijken.py",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development node scripts/start-electron.cjs\"",
    "electron:start": "npm run build && node scripts/start-electron.cjs",
    "electron:build": "npm run build && electron-builder --win --config.win.signAndEditExecutable=false",
    "electron:publish": "npm run build && electron-builder --win --publish always",
    "cap:sync": "npm run build && node scripts/clean-native-assets.cjs && cap sync",
    "android:apk": "npm run cap:sync && node scripts/android-apk.cjs",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "assets:icons": "capacitor-assets generate --iconBackgroundColor '#0b1220' --iconBackgroundColorDark '#0b1220' --splashBackgroundColor '#0b1220' --splashBackgroundColorDark '#0b1220'",
    "postinstall": "node scripts/postinstall.cjs",
    "site:ophalen": "node scripts/site-ophalen.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@supabase/supabase-js": "^2.112.4",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@electric-sql/pglite": "^0.5.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.2.5",
    "supabase": "^2.116.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/truckwashgroup/truckwash-dashboard.git"
  },
  "homepage": "https://github.com/truckwashgroup/truckwash-dashboard",
  "optionalDependencies": {
    "@img/sharp-win32-x64": "^0.35.4"
  },
  "engines": {
    "node": ">=20"
  }
}
